[Unit]
Description=CyberMiao isolated account-mode test service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=cybermiao-test
Group=cybermiao-test
WorkingDirectory=/opt/cybermiao-test/app/server
StateDirectory=cybermiao-test
StateDirectoryMode=0700
UMask=0077
LoadCredential=dashscope_api_key:/etc/cybermiao-test/api_key
Environment=CYBERMIAO_DATA_DIR=/var/lib/cybermiao-test
Environment=CYBERMIAO_CLOUD_TEST_PORT=8081
Environment=QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
Environment=QWEN_REALTIME_VOICE=Tina
Environment=HAND_TRACKING_ENABLED=0
Environment=MPLBACKEND=Agg
Environment=MPLCONFIGDIR=/var/lib/cybermiao-test/matplotlib
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LD_LIBRARY_PATH=/opt/cybermiao-test/native/root/usr/lib/x86_64-linux-gnu
ExecStart=/opt/cybermiao-test/venv/bin/python /opt/cybermiao-test/app/server/cloud_test_entry.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
